  "cards": [
    {
      "dot": "emerald",
      "title": "改什么",
      "items": [
        "扩展批量不再逐个进队列，直接跑批量引擎",
        "并发 16 / 每站 6（沿用配置），共享连接池与单请求",
        "同一时间只允许一个批量任务，避免把站点打爆"
      ]
    },
    {
      "dot": "rose",
      "title": "边界",
      "items": [
        "批量任务只在服务端内存，重启即丢（文件已落盘）",
        "取消会停止活动下载与未开始项",
        "第二阶段：批量内大文件多连接（限流按 socket 计数）"
      ]
    }
  ]
