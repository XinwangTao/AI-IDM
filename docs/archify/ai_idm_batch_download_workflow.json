      "label": "重试退避",
      "sublabel": "429 降并发",
      "width": 96
    },
    {
      "id": "f2",
      "lane": "exceptions",
      "col": 4,
      "type": "messagebus",
      "label": "记入失败清单",
      "sublabel": "下次 --resume 续跑",
      "width": 108
    }
  ],
  "edges": [
    {
      "from": "n1",
      "to": "n2"
    },
    {
      "from": "n2",
      "to": "n3"
    },
    {
      "from": "n3",
      "to": "n4",
      "label": "取任务"
    },
    {
      "from": "n4",
      "to": "n5",
      "label": "长度超阈值且支持 Range"
    },
    {
      "from": "n4",
      "to": "n6",
      "label": "小文件"
    },
    {
      "from": "n5",
      "to": "n6",
      "label": "分段写入"
    },
    {
      "from": "n6",
      "to": "n7",
      "label": "完成"
    },
    {
      "from": "n4",
      "to": "f1",
      "label": "请求失败",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "from": "f1",
      "to": "n4",
      "label": "重试",
      "variant": "dashed",
      "role": "return"
    },
    {
      "from": "f1",
      "to": "f2",
      "label": "超过上限",
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "借鉴与取舍",
      "items": [
        "aria2：小文件不切段，并发放在文件之间",
        "wget2：连接复用是小文件吞吐的最大杠杆",
        "HTTP/2 多路复用受标准库限制，本轮不做",
        "rclone：清单化 + 失败隔离 + 可续跑"
      ]
    },
    {
      "dot": "rose",
      "title": "验收",
      "items": [
        "200×20KB 实测 265.4s → 0.35s（约 758×，本机回环）",
        "失败率 0，单个失败不拖垮整批",
        "不触发目标站限流：每站并发有上限，429 继续降"
      ]
    },
    {
      "dot": "cyan",
      "title": "入口",
      "items": [
        "ai-idm batch urls.txt -o DIR（保留目录结构）",
        "扩展右键：下载本页所有链接/图片",
        "服务端 /batch 复用同一调度器"
      ]
    }
  ]
}