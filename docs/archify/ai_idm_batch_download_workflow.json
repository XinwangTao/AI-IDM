      "toCol": 1
    },
    {
      "id": "run",
      "label": "并发下载",
      "fromCol": 2,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "close",
      "label": "收尾",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "n1",
    "n2",
    "n3",
    "n4",
    "n5",
    "n6"
  ],
  "nodes": [
    {
      "id": "n1",
      "lane": "prep",
      "col": 0,
      "type": "frontend",
      "label": "批量输入",
      "sublabel": "CLI 清单 / 扩展抓页",
      "width": 108
    },
    {
      "id": "n2",
      "lane": "prep",
      "col": 1,
      "type": "backend",
      "label": "规范化去重",
      "sublabel": "URL + 落地路径",
      "width": 104
    },
    {
      "id": "n3",
      "lane": "prep",
      "col": 2,
      "type": "security",
      "label": "并发调度",
      "sublabel": "全局 16 / 每站 6",
      "width": 104
    },
    {
      "id": "n4",
      "lane": "engine",
      "col": 3,
      "type": "frontend",
      "label": "单 GET 取流",
      "sublabel": "小文件一次完成",
      "width": 104
    },
    {
      "id": "n5",
      "lane": "engine",
      "col": 4,
      "type": "backend",
      "label": "大文件回退",
      "sublabel": "按 Range 分段",
      "width": 100
    },
    {
      "id": "n6",
      "lane": "engine",
      "col": 5,
      "type": "messagebus",
