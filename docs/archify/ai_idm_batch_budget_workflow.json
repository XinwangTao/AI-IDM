  "cards": [
    {
      "dot": "emerald",
      "title": "改什么",
      "items": [
        "每站限流从“按文件”改为“按 socket”：小文件占 1，大文件占 N",
        "大文件在批量里也能多连接分段，不再被迫单连接",
        "HLS 增加取消句柄，批量取消能中断正在跑的分片"
      ]
    },
    {
      "dot": "rose",
      "title": "边界",
      "items": [
        "预算用信号量，拿不到就排队，不会超发",
        "完成/失败/取消都要归还预算，避免泄漏",
        "HTTP 与 HLS 共用同一套取消信号"
      ]
    }
  ]
